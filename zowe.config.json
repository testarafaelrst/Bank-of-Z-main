{
    "$schema": "./zowe.schema.json",
    "profiles": {
        "bank-of-z": {
            "properties": {
                "host": "ESYSMVS.wsclab.washington.ibm.com",
                "protocol": "https",
                "rejectUnauthorized": false
            },
            "secure": [
                "user",
                "password"
            ],
            "profiles": {
                "zosmf": {
                    "type": "zosmf",
                    "properties": {
                        "port": 10443
                    }
                },
                "ssh": {
                    "type": "ssh",
                    "properties": {
                        "port": 22
                    }
                },
                "rse": {
                    "type": "rse",
                    "properties": {
                        "port": 8195,
                        "basePath": "rseapi"
                    }
                },
                "cics": {
                    "type": "cics",
                    "properties": {
                        "port": 3044,
                        "protocol": "https",
                        "rejectUnauthorized": false,
                        "regionName": "CICSAOR1"
                    },
                    "secure": []
                },
                "zOpenDebug": {
                    "type": "zOpenDebug",
                    "properties": {
                        "host": "ESYSMVS.wsclab.washington.ibm.com",
                        "dpsPort": 8143,
                        "dpsContextRoot": "api/v1",
                        "dpsSecured": true,
                        "rdsPort": 8002,
                        "rdsSecured": true
                    },
                    "secure": [
                        "user",
                        "password"
                    ]
                }
            }
        }
    },
    "defaults": {
        "zosmf": "bank-of-z.zosmf",
        "ssh": "bank-of-z.ssh",
        "rse": "bank-of-z.rse",
        "cics": "bank-of-z.cics",
        "zOpenDebug": "bank-of-z.zOpenDebug"
    },
    "autoStore": true
}